# Normalize line endings to LF for all text files, regardless of OS/editor settings.
* text=auto eol=lf

*.svelte text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.md     text eol=lf
*.svg    text eol=lf

# Binary-ish assets should never be touched
*.png    binary
*.jpg    binary
*.ico    binary
